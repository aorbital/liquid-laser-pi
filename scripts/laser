#!/usr/bin/env bash
set -euo pipefail
PROJECT="${LIQUID_LASER_PROJECT:-$HOME/liquid-laser-pi}"
BUILD="$PROJECT/build"
cd "$PROJECT"
cmake -S . -B "$BUILD" -DCMAKE_BUILD_TYPE=Release >/dev/null
cmake --build "$BUILD" -j2
REDIST=$(dirname "$(find "$HOME/ros2_astra_camera_openni" -type f -name 'libOpenNI2.so' | grep '/arm64/' | head -n 1)")
LASERLIB=$(find "$HOME/laserdocklib/build" -type f \( -name 'liblaserdocklib.so' -o -name 'liblaserdocklib.a' \) | head -n 1)
export OPENNI2_REDIST="$REDIST"
export OPENNI2_REDIST64="$REDIST"
export LD_LIBRARY_PATH="$REDIST:$(dirname "$LASERLIB"):${LD_LIBRARY_PATH:-}"
exec "$BUILD/liquid_laser" "$@"
